@model FoodTour.Models.AdminVisitRecordedEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Subject</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa;">
    <table style="width: 100%; background-color: #f8f9fa; border-collapse: collapse; border-spacing: 0;">
        <tbody>
            <tr>
                <td style="padding: 24px 12px; text-align: center;">
                    <table style="width: 600px; max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden; border-collapse: separate; border-spacing: 0;">
                        <tbody>
                            <tr>
                                <td style="padding: 24px; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; color: #212529; text-align: left;">
                                    <p style="margin: 0 0 12px 0;"><strong>Notification:</strong> A Food Tour visit has been recorded.</p>
                                    <p style="margin: 0 0 8px 0;"><strong>Booking Ref:</strong> #@Model.BookingRef</p>
                                    <p style="margin: 0 0 8px 0;"><strong>Customer Email:</strong> @Model.CustomerEmail</p>
                                    <p style="margin: 0 0 8px 0;"><strong>Tour Date:</strong> @Model.TourDate</p>
                                    <p style="margin: 0 0 8px 0;"><strong>Tour Guests:</strong> @Model.TotalGuests</p>
                                    <p style="margin: 0 0 8px 0;"><strong>Supplier:</strong> @Model.SupplierName</p>
                                    <p style="margin: 0 0 8px 0;"><strong>Claimed At (UTC):</strong> @Model.ClaimedAt</p>

                                    <table style="width: 100%; border-collapse: collapse; margin-top: 12px;">
                                        <thead>
                                            <tr>
                                                <th style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;"><strong>Booking Ref</strong></th>
                                                <th style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;"><strong>Customer Email</strong></th>
                                                <th style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;"><strong>Tour Date</strong></th>
                                                <th style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;"><strong>Tour Guests</strong></th>
                                                <th style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;"><strong>Supplier</strong></th>
                                                <th style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;"><strong>Claimed At (UTC)</strong></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;">@Model.BookingRef</td>
                                                <td style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;">@Model.CustomerEmail</td>
                                                <td style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;">@Model.TourDate</td>
                                                <td style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;">@Model.TotalGuests</td>
                                                <td style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;">@Model.SupplierName</td>
                                                <td style="border: 1px solid #e5e5e5; text-align: left; padding: 8px;">@Model.ClaimedAt</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
