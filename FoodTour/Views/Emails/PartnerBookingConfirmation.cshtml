@model FoodTour.Models.PartnerBookingConfirmationEmailModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Subject</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8f9fa;">
    <table style="width: 100%; background-color: #f8f9fa; border-collapse: collapse; border-spacing: 0;">
        <tbody>
            <tr>
                <td style="padding: 24px 12px; text-align: center;">
                    <table style="width: 600px; max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e5e5; border-radius: 8px; overflow: hidden; border-collapse: separate; border-spacing: 0;">
                        <tbody>
                            <tr>
                                <td style="padding: 24px; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; color: #212529; text-align: left;">
                                    <p style="margin: 0 0 12px 0;">Hello,</p>
                                    <p style="margin: 0 0 12px 0;">
                                        We received a request to confirm the email address for booking reference <strong>@Model.BookingReference</strong>.
                                    </p>
                                    <p style="margin: 0 0 12px 0;">
                                        Please confirm this email address so we can locate your booking and allow you to select your tasting experiences.
                                    </p>
                                    <p style="margin: 0 0 12px 0;">
                                        This confirmation link expires after 24 hours.
                                    </p>

                                    <table style="margin: 0 auto 12px auto; border-collapse: collapse; border-spacing: 0;">
                                        <tr>
                                            <td style="border-radius: 6px; background-color: #0d6efd; text-align: center;">
                                                <a href="@Model.ValidationUrl" style="display: inline-block; padding: 10px 14px; font-family: Arial, sans-serif; font-size: 16px; color: #ffffff; text-decoration: none; border-radius: 6px;">Confirm my email</a>
                                            </td>
                                        </tr>
                                    </table>

                                    <p style="margin: 0 0 8px 0;">If the button does not work, copy and paste this link into your browser:</p>
                                    <p style="margin: 0 0 12px 0; word-break: break-word;"><a href="@Model.ValidationUrl" style="color: #0d6efd;">@Model.ValidationUrl</a></p>

                                    <p style="margin: 0 0 12px 0;">
                                        This email address will only be used to confirm your booking at tasting experiences and will not be used for anything else.
                                    </p>
                                    <p style="margin: 0 0 16px 0;">
                                        For more information about how we process your data, please read our <a href="@Model.PrivacyPolicyUrl" style="color: #0d6efd;">Privacy Policy</a>.
                                    </p>
                                    <p style="margin: 0 0 12px 0;">We look forward to seeing you!</p>
                                    <p style="margin: 0 0 16px 0;">Best regards,<br /><strong>Kabincraft Adventures</strong></p>

                                    <hr style="margin: 16px 0; border: 0; border-top: 1px solid #e5e5e5;" />
                                    <p style="margin: 0; color: #6c757d; font-size: 14px;">This email was sent from an unattended mailbox. Please do not reply.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
</body>
</html>
