@model ErrorViewModel
@{
	ViewData["Title"] = "Error";
}

<div class="container text-center mt-5">
	<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="container">
		<div class="row justify-content-center text-center">
			<div class="col-12 col-md-8 col-lg-6">
				<div class="card shadow-sm mb-4">
					<div class="card-body p-4 p-md-5">
						<h1 class="card-title mb-4">
							<i class="bi bi-exclamation-triangle text-warning"></i> Oops! Something went wrong
						</h1>

						<p class="mb-3">We're sorry, but an unexpected error has occurred while processing your request.</p>
						<p class="mb-4">Please try refreshing the page, or go back to the homepage and try again.</p>

						<div class="d-grid d-sm-flex gap-2 mb-3 justify-content-center">
							<button onclick="window.location.reload();" class="btn btn-primary">
								<i class="bi bi-arrow-clockwise"></i> Refresh Page
							</button>
						</div>

						@if (Model.ShowRequestId) {
							<div class="mt-4 p-2 bg-light rounded">
								<small class="text-muted">
									<strong>Reference ID:</strong> <code>@Model.RequestId</code>
								</small>
							</div>
						}
					</div>
				</div>

				<!-- Support Card -->
				<div class="card">
					<div class="card-body text-center">
						<h2 class="card-title">
							<i class="bi bi-headset text-primary"></i> Need Help?
						</h2>
						<p class="mb-0">
							If this problem persists, please contact support for assistance.
						</p>
						<a asp-controller="Home" asp-action="UserSupport" class="btn btn-outline-primary btn-sm mt-2">
							<i class="bi bi-arrow-right"></i> Contact Support
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
