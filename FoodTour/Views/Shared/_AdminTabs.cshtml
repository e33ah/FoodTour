@{
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3 border-bottom">
	<ul class="nav nav-tabs border-0">
		<li class="nav-item">
			<a class="nav-link @(currentAction == "Dashboard" ? "active" : "text-dark")" asp-controller="Admin" asp-action="Dashboard">
				<i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard
			</a>
		</li>
		<li class="nav-item">
			<a class="nav-link @(currentAction == "Bookings" ? "active" : "text-dark")" asp-controller="Admin" asp-action="Bookings">
				<i class="bi bi-calendar-check" aria-hidden="true"></i> Bookings
			</a>
		</li>
		<li class="nav-item">
			<a class="nav-link @(currentAction == "Visits" ? "active" : "text-dark")" asp-controller="Admin" asp-action="Visits">
				<i class="bi bi-shop" aria-hidden="true"></i> Visits
			</a>
		</li>
		<li class="nav-item">
			@{
				bool isSuppliersTab = currentAction is "Suppliers" or "CreateSupplier" or "EditSupplier";
			}
			<a class="nav-link @(isSuppliersTab ? "active" : "text-dark")" asp-controller="Admin" asp-action="Suppliers">
				<i class="bi bi-building" aria-hidden="true"></i> Suppliers
			</a>
		</li>
	</ul>
	<form asp-controller="Admin" asp-action="Logout" method="post" class="mb-1">
		@Html.AntiForgeryToken()
		<button type="submit" class="btn btn-outline-secondary btn-sm">
			<i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sign out
		</button>
	</form>
</div>
