@if (!Context.Request.Cookies.ContainsKey("cookie-consent")) {
	<div id="cookie-consent-banner" class="cookie-consent-banner">
		<div class="cookie-consent-content">
			<p class="cookie-consent-text">
				<i class="bi bi-cookie"></i>
				We use cookies to enhance your browsing experience and analyse our traffic. 
				By clicking "Accept", you consent to our use of cookies.
				<a asp-controller="Home" asp-action="Privacy" class="cookie-consent-link">Learn more</a>
			</p>
			<div class="cookie-consent-buttons">
				<button id="cookie-consent-accept" class="btn btn-success btn-sm">Accept</button>
				<button id="cookie-consent-decline" class="btn btn-outline-secondary btn-sm">Decline</button>
			</div>
		</div>
	</div>
}
