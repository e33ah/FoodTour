@model FoodTour.Models.SupplierVisitVM

@{
	ViewData["Title"] = "Food Tour Visit";
}

<div class="container mt-5">
	<img src="~/images/logo_with_wording.jpg" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="row justify-content-center text-center">
		<div class="col-12 col-md-8 col-lg-6">
			<div class="card shadow-sm">
				<div class="card-body p-4 p-md-5">
					<h1 class="card-title mb-4">
						<i class="bi bi-fork-knife text-primary"></i> Food Tour Visit
					</h1>
					<p class="text-muted">Thank you for participating in Weymouth FoodTour!</p>
					<div>
						<form id="supplierVisitForm" asp-action="SupplierSelect" method="post" class="row d-flex flex-row align-items-center mb-2 justify-content-center">
							@Html.AntiForgeryToken()
							<div class="col-12 col-md-10 col-lg-8 py-1">
								<label asp-for="SelectedSupplierId" class="form-label">Select your business to confirm customer visit:</label>
								<span asp-validation-for="SelectedSupplierId" class="text-danger"></span>
								<select asp-for="SelectedSupplierId" class="form-select">
									<option value="">-- Select business --</option>
									@if (Model?.Suppliers != null) {
										foreach (var supplier in Model.Suppliers) {
											<option value="@supplier.Id">@supplier.Name</option>
										}
									}
								</select>
								<label for="supplierCode" class="form-label mt-3">Enter your Code:</label>
								<input id="supplierCode" name="supplierCode" type="text" class="form-control" autocomplete="off" />
								<button type="submit" id="btnConfirmVisit" class="btn btn-primary mt-4">Confirm Visit</button>
							</div>
							<div id="supplierErrorRegion" class="text-danger d-none"></div>
						</form>
					</div>
				</div>
			</div>
		</div>
		<p class="text-muted mt-4">
			Need help? Visit our
			<a asp-controller="Home" asp-action="UserSupport">Support</a>
			page.
		</p>
	</div>
</div>

@section Scripts {
	<script type="text/javascript">
		(function () {
		var form = document.getElementById('supplierVisitForm');
		if (!form) {
		return;
		}

		form.addEventListener('submit', async function (e) {
		e.preventDefault();

		var select = form.querySelector('select[name="SelectedSupplierId"]');
		var selectedValue = select ? select.value : '';
		var supplierCodeInput = form.querySelector('input[name="supplierCode"]');
		var supplierCode = supplierCodeInput ? supplierCodeInput.value.trim() : '';

		if (!selectedValue) {
		var errorRegion = document.getElementById('supplierErrorRegion');
		if (errorRegion) {
		errorRegion.textContent = 'Please select your business to confirm the visit.';
		errorRegion.classList.remove('d-none');
		}
		return;
		}

		if (!supplierCode) {
		var errorRegion = document.getElementById('supplierErrorRegion');
		if (errorRegion) {
		errorRegion.textContent = 'Please enter your business\'s code to confirm the visit.';
		errorRegion.classList.remove('d-none');
		}
		return;
		}

		var errorRegion = document.getElementById('supplierErrorRegion');
		if (errorRegion) {
		errorRegion.classList.add('d-none');
		errorRegion.textContent = '';
		}

		var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
		var token = tokenInput ? tokenInput.value : '';

		var payload = {
		qrToken: '@Model.QrToken',
		selectedSupplierId: Number(selectedValue),
		supplierCode: supplierCode
		};

		try {
		var recordUrl = '@Url.Action("RecordVisit", "Home")';
		var response = await fetch(recordUrl, {
		method: 'PUT',
		headers: {
		'Content-Type': 'application/json',
		'RequestVerificationToken': token
		},
		body: JSON.stringify(payload)
		});

		if (response.ok) {
		window.location.href = '/Home/VisitConfirmation';
		return;
		}

		var errorText = 'An error occurred while recording the visit.';
		try {
		var errorJson = await response.json();
		if (errorJson && errorJson.error) {
		errorText = errorJson.error;
		} else if (errorJson && errorJson.message) {
		errorText = errorJson.message;
		}
		} catch (parseErr) {
		// ignore JSON parse errors and use generic message
		}

		alert(errorText);
		} catch (networkErr) {
		alert('Network error while recording the visit. Please try again.');
		}
		});
		})();
	</script>
}