@model FoodTour.Models.BookingConfirmationVM
@{
	ViewData["Title"] = "Booking Confirmation";
}

<div class="container">
	<div class="row justify-content-center text-center">
		<div class="col-md-8 col-lg-6">
			<div class="card mb-4">
				<div class="card-body">
					<h3 class="card-title">
						<i class="bi bi-check-circle"></i> Booking Confirmed
					</h3>
					<p class="mt-3">Thank you, <strong>@Model.CustomerEmail</strong>, for booking your Weymouth Self-Guided Tasting Tour!</p>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="container text-center">
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="align-content-center">
				<p> If you wish to change or cancel your tour, please contact <a href="mailto:admin@foodtour.com">admin@foodtour.com</a></p>
			</div>
			<div class="d-flex flex-wrap gap-2 justify-content-center">
				<a href="@Url.Action("Index", "Home")" class="btn btn-primary">
					<i class="bi bi-house-door"></i> Back to Home
				</a>
			</div>
		</div>
	</div>
</div>