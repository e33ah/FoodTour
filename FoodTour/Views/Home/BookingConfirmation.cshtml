@model FoodTour.Models.BookingConfirmationVM
@{
	ViewData["Title"] = "Booking Confirmation";
}

<div class="container mt-5">
	<img src="~/images/logo_with_wording.jpg" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="row justify-content-center text-center">
		<div class="col-12 col-md-8 col-lg-6">
			<div class="card shadow-sm mb-4">
				<div class="card-body p-4 p-md-5">
					<h1 class="card-title">
						<i class="bi bi-check-circle text-success" aria-hidden="true"></i> Booking Confirmed
					</h1>
					<p class="mt-3">Thank you, <strong>@Model.CustomerEmail</strong>, for booking your Weymouth Self-Guided Tasting Tour!</p>
					<a href="@Url.Action("FoodTourCode", "Home", new { qrToken = Model.QrToken })" class="btn btn-primary btn-lg">
						<i class="bi bi-signpost"></i> View Tour Details
					</a>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="container text-center">
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6 align-content-center">
			@if (Context.Request.Query["emailWarningMessage"] is { Count: > 0 } emailWarningMessage && !string.IsNullOrWhiteSpace(emailWarningMessage.ToString())) {
				<div class="alert alert-warning" role="alert">
					<i class="bi bi-exclamation-triangle"></i>
					The email address entered appears to be incorrect.<br />
					Your booking has been saved, but you won’t receive a confirmation email.<br /><br />
					Please save the tour link above to use on the day, or contact <a asp-controller="Home" asp-action="UserSupport">Support</a>, if you’d like us to resend your confirmation.
				</div>
			}
			<p class="text-muted">
				To change or cancel your tour, please visit our
				<a asp-controller="Home" asp-action="UserSupport">Support</a>
				page.
			</p>
		</div>
	</div>
</div>