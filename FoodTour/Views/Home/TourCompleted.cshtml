@{
	ViewData["Title"] = "Tour Completed";
}
<div class="container mt-5 text-center">
	<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="card shadow-sm mb-4">
				<div class="card-body  p-4 p-md-5">
					<h1 class="card-title mb-4">
						<i class="bi bi-dash-circle text-primary"></i> Tour complete!
					</h1>

					<p>All tasting experiences have been completed for this tour. </p>
					<p>No further tasting experiences should be provided.</p>

				</div>
			</div>
		</div>
		<p class="text-muted">
			Need help? Visit our
			<a asp-controller="Home" asp-action="UserSupport">Support</a>
			page.
		</p>
	</div>
</div>

