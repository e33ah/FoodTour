@{
	ViewData["Title"] = "Tour Completed";
}
<div class="container text-center mt-5">
	<img src="~/images/logo_with_wording.jpg" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block" style="max-height: 100px;" />
	<div class="container">
		<div class="row justify-content-center text-center">
			<div class="col-md-8 col-lg-6">
				<div class="card mb-4">
					<div class="card-body">
						<h1 class="card-title mb-4">
							This Tour is now complete!
						</h1>

						<p>All tasting experiences have been completed for this tour. </p>
						<p>No further tasting experiences should be provided.</p>

					</div>
				</div>
			</div>
		</div>
	</div>
	<p>
		For help and support, please visit our
		<a asp-controller="Home" asp-action="UserSupport">Support</a>
		page.
	</p>

</div>