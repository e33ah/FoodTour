@model FoodTour.Models.UserSupportVM;
@{
	ViewData["Title"] = "Support";
}
<div class="container py-5">
	<div class="row justify-content-center">
		<div class="col-12 col-md-10 col-lg-8">
			<div class="text-center mb-4">
				<h1 class="mb-2"><span class="text-primary me-2"><i class="bi bi-headset" aria-hidden="true"></i></span>Support</h1>
				<p class="text-muted mb-0">We are here to help you get the most out of your FoodTour experience.</p>
			</div>

			<div class="card shadow-sm">
				<div class="card-body p-4 p-md-5">
					<div class="d-flex flex-column align-items-center gap-3 text-center">
						<div class="flex-grow-1">
							<p class="mb-3">
								If you need help during your tour, please contact our support team and we will do our best to respond promptly.
							</p>

							<div class="d-grid d-sm-flex gap-2 mb-0 justify-content-center">
								<a class="btn btn-outline-primary" href="tel:@Model.SupportPhoneNumberDial">
									<i class="bi bi-telephone" aria-hidden="true"></i>
									Call @Model.SupportPhoneNumberDisplay
								</a>
								<a class="btn btn-outline-primary" href="mailto:@Model.SupportEmailAddress">
									<i class="bi bi-envelope" aria-hidden="true"></i>
									Email @Model.SupportEmailAddress
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
