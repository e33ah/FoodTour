@model FoodTour.Models.FoodTourVM

@{
	ViewData["Title"] = "Home Page";
	ViewData["TourDate"] = Model.TourDate;
	List<string> availableTags = Model.Suppliers
		.SelectMany(supplier => new[] { supplier.Tag1, supplier.Tag2, supplier.Tag3, supplier.Tag4 })
		.Where(tag => !string.IsNullOrWhiteSpace(tag))
		.Select(tag => tag!.Trim())
		.Distinct(StringComparer.OrdinalIgnoreCase)
		.OrderBy(tag => tag)
		.ToList();
}

<div class="text-center">
	<div class="header-section mb-4">
		<!-- Mobile layout: Logo above title (stacked) -->
		<div class="d-flex d-md-none flex-column align-items-center">
			<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 page-logo-mobile" />
			<h1 class="display-5 mb-0">Weymouth Self-Guided Tasting Tour</h1>
		</div>

		<!-- Desktop/Tablet layout: Logo and title side by side -->
		<div class="d-none d-md-flex align-items-center justify-content-center">
			<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid me-3 page-logo" />
			<h1 class="display-4 mb-0">Weymouth Self-Guided Tasting Tour</h1>
		</div>
	</div>

	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-8 col-lg-6">
				@if (ViewData.ModelState.TryGetValue(string.Empty, out var generalErrors) && generalErrors.Errors.Count > 0) {
					<div class="alert alert-warning alert-dismissible fade show text-start" role="alert">
						<div class="d-flex">
							<i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
							<div>
								<strong>We couldn't create your tour</strong>
								<ul class="mb-0 mt-2 ps-3">
									@foreach (var error in generalErrors.Errors.Where(error => !string.IsNullOrWhiteSpace(error.ErrorMessage))) {
										<li>@Html.Raw(error.ErrorMessage)</li>
									}
								</ul>
							</div>
						</div>
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				}
				@if (Model.NoSuppliersMessage != null) {
					<div class="alert alert-info" role="alert">
						<i class="bi bi-info-circle"></i> @Model.NoSuppliersMessage
					</div>
				}
				else {
					@if (Model.InsufficientSuppliersWarning != null) {
						<div class="alert alert-warning" role="alert">
							<i class="bi bi-exclamation-triangle"></i> @Model.InsufficientSuppliersWarning
						</div>
					}
					<form id="tourForm" asp-action="Index" method="post"
						  data-max-selections="@Model.MaxSelections"
						  data-selected-suppliers='@Html.Raw(JsonSerializer.Serialize(Model.SelectedSuppliers))'
						  data-heading-template="Select {0} tasting experiences to create your personalised food tasting tour"
						  data-heading-template-no-count="Select your tasting experiences to create your personalised food tasting tour">
						<input type="hidden" id="BookingId" name="BookingId" value="@Model.BookingId" />
						<h2 id="selectionHeading" class="lead mb-3 fs-3">@if (Model.MaxSelections > 0) {<text>Select @Model.MaxSelections tasting experiences to create your personalised food tasting tour</text>} else {<text>Select your tasting experiences to create your personalised food tasting tour</text>}</h2>

						<p class="mb-4">
							Some venues are designed for quick visits and may not include seating.
						</p>
						<div class="card mb-4 mt-4">
							<div class="card-body">
								<h3 class="card-title">
									<i class="bi bi-send text-primary"></i> Email
								</h3>
								<small class="form-text text-muted mb-2 mt-2 d-block">
									Enter the email address used to make your booking
								</small>
								<div class="form-group">
									<label for="customerEmail" class="form-label visually-hidden">Email Address</label>
									<input id="customerEmail" name="customerEmail" type="email" class="form-control" placeholder="your.email@example.com" value="@Model.CustomerEmail" aria-label="Email Address" />
								</div>
							</div>
						</div>
						<div class="card mb-4 mt-4">
							<div class="card-body">
								<h3 class="card-title">
									<i class="bi bi-hash text-primary"></i> Booking Reference
								</h3>
								<small class="form-text text-muted mb-2 mt-2 d-block">
									Enter your booking reference (found in your confirmation email)
								</small>
								<div class="form-group">
									<label for="purchaseCode" class="form-label visually-hidden">Booking Reference</label>
									<div class="d-flex justify-content-center">
										<span class="input-group-text bg-transparent text-muted">#</span>
										<input id="purchaseCode" name="purchaseCode" type="text" class="form-control w-auto" style="max-width: 220px;" placeholder="123456789" value="@Model.PurchaseCode" aria-label="Booking Reference" />
									</div>
								</div>
							</div>
						</div>
						<div id="bookingStatusMessage" class="alert mb-4 d-none" role="alert" aria-label="Booking status" tabindex="-1">
							<i id="bookingStatusIcon" class="bi" aria-hidden="true"></i>
							<span id="bookingStatusText"></span>
						</div>
						<div id="partnerConfirmationPrompt" class="alert alert-info mb-4 d-none" role="alert" aria-label="Partner booking confirmation">
							<div class="row g-3 align-items-center">
								<div class="col-12 col-lg">
									<div id="partnerConfirmationMessage" class="text-center">
										<i class="bi bi-info-circle-fill"></i>
									</div>
								</div>
								<div class="col-12 col-lg-auto">
									<div class="text-center text-lg-end">
										<a id="partnerConfirmationLink" href="#" class="btn btn-primary">
											<i class="bi bi-envelope-check"></i> Confirm email
										</a>
									</div>
								</div>
							</div>
						</div>
						@if (availableTags.Count > 0) {
							<div class="supplier-filter-bar mb-2">
								<div class="supplier-tag-filter d-flex justify-content-end">
									<div class="text-start supplier-tag-filter-control">
										<div class="d-flex align-items-center gap-1">
											<label for="supplierTagFilter" class="visually-hidden">Filter tasting experiences by type</label>
											<button type="button" id="supplierTagFilterIconButton" class="btn btn-link supplier-tag-filter-icon-btn text-muted p-0" aria-label="Filter tasting experiences by type" title="Filter tasting experiences by type" disabled tabindex="-1" aria-disabled="true">
												<i id="supplierTagFilterIcon" class="bi bi-funnel" aria-hidden="true"></i>
											</button>
											<select id="supplierTagFilter" class="form-select form-select-sm" style="min-width: 180px; max-width: 240px;" aria-label="Filter tasting experiences by type">
												<option value="">All experiences</option>
											@foreach (var tag in availableTags) {
												<option value="@tag">@tag</option>
											}
											</select>
										</div>
										<div id="supplierTagFilterStatus" class="small text-muted mt-1 d-none" aria-live="polite"></div>
										<div id="supplierTagNoResults" class="small text-muted mt-1 d-none" role="status" aria-live="polite">
											No tasting experiences match this type.
										</div>
									</div>
								</div>
							</div>
						}
						@foreach (var item in Model.Suppliers) {
							<partial name="_SupplierCard" model="item" />
						}
						<div class="text-center mt-4">
							<button type="submit" class="btn btn-primary btn-lg" id="createTourBtn" disabled>Create My Tour</button>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="bookingConfirmedModal" tabindex="-1" aria-labelledby="bookingConfirmedModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header bg-info-subtle">
				<h5 class="modal-title" id="bookingConfirmedModalLabel">
					<i class="bi bi-info-circle-fill"></i> Tasting Selection Complete
				</h5>
				<button type="button" class="btn-close btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p class="text-center mb-3">Tasting experiences have already been selected for this tour.</p>
				<p class="text-center mb-3">
					<a href="#" id="viewTourDetailsLink" class="btn btn-primary">
						<i class="bi bi-calendar-check"></i> View Your Tour Details
					</a>
				</p>
				<p class="text-center text-muted small mb-0">
					Need help? <a asp-action="UserSupport" asp-controller="Home">Contact Support</a>
				</p>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/tour-selection.js" asp-append-version="true"></script>
}
