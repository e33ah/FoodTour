@model FoodTour.Models.FoodTourVM

@{
	ViewData["Title"] = "Home Page";
}

<div class="text-center">
	<div class="header-section mb-4">
		<!-- Mobile layout: Logo above title (stacked) -->
		<div class="d-flex d-md-none flex-column align-items-center">
			<img src="~/images/logo_with_wording.jpg" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3" style="max-height: 80px;" />
			<h1 class="display-5 mb-0">Weymouth Self-Guided Tasting Tour</h1>
		</div>

		<!-- Desktop/Tablet layout: Logo and title side by side -->
		<div class="d-none d-md-flex align-items-center justify-content-center">
			<img src="~/images/logo_with_wording.jpg" alt="Kabincraft Food Tours Logo" class="img-fluid me-3" style="max-height: 100px;" />
			<h1 class="display-4 mb-0">Weymouth Self-Guided Tasting Tour</h1>
		</div>
	</div>

	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-8 col-lg-6">
				@if (ViewBag.NoSuppliersMessage != null) {
					<div class="alert alert-info" role="alert">
						<i class="bi bi-info-circle"></i> @ViewBag.NoSuppliersMessage
					</div>
				}
				else {
					@if (ViewBag.InsufficientSuppliersWarning != null) {
						<div class="alert alert-warning" role="alert">
							<i class="bi bi-exclamation-triangle"></i> @ViewBag.InsufficientSuppliersWarning
						</div>
					}
					<form id="tourForm" asp-action="Index" method="post"
						  data-max-selections="@Model.MaxSelections"
						  data-selected-suppliers='@Html.Raw(JsonSerializer.Serialize(ViewBag.SelectedSuppliers ?? new List<int>()))'
						  data-focus-purchase-code='@JsonSerializer.Serialize((bool?)ViewBag.FocusPurchaseCode == true)'>
						<h2 class="lead mb-3 fs-3">Select @Model.MaxSelections tasting experiences to create your personalised food tasting tour</h2>

						<p class="mb-4">
							Some venues are designed for quick visits and may not include seating.
						</p>

						<div class="card mb-4">
							<div class="card-body">
								<h3 class="card-title mb-3">
									<i class="bi bi-calendar-event text-primary"></i> Select Your Tour Date
								</h3>
								<div class="form-group">
									<small class="form-text text-muted mb-2 mt-2 d-block">
										Tours are available daily from April to November
									</small>
									<label asp-for="TourDate" class="form-label visually-hidden">Tour Date</label>
									<div class="d-flex justify-content-center">
										<input asp-for="TourDate" type="date" class="form-control w-auto" id="tourDate" style="max-width: 220px;" />
									</div>
									<span asp-validation-for="TourDate" class="text-danger"></span>
								</div>
							</div>
						</div>
						@foreach (var item in Model.Suppliers) {
							<partial name="_SupplierCard" model="item" />
						}
						<div class="card mb-4 mt-4">
							<div class="card-body">
								<h3 class="card-title">
									<i class="bi bi-send text-primary"></i> Email
								</h3>
								<small class="form-text text-muted mb-2 mt-2 d-block">
									Please provide your email address to receive your tour details.
								</small>
								<div class="form-group mb-3">
									<label asp-for="CustomerEmail" class="form-label visually-hidden">Email Address</label>
									<input asp-for="CustomerEmail" type="email" class="form-control" placeholder="your.email@example.com" />
									<span asp-validation-for="CustomerEmail" class="text-danger"></span>
								</div>
								<small class="form-text text-muted mb-2 mt-2 d-block">
									Please re-enter your email address.
								</small>
								<div class="form-group">
									<label asp-for="CustomerEmailConfirmation" class="form-label visually-hidden">Confirm Email Address</label>
									<input asp-for="CustomerEmailConfirmation" type="email" class="form-control" placeholder="your.email@example.com" />
									<span asp-validation-for="CustomerEmailConfirmation" class="text-danger"></span>
								</div>
							</div>
						</div>
						<div class="card mb-4 mt-4">
							<div class="card-body">
								<h3 class="card-title">
									<i class="bi bi-key text-primary"></i> Purchase Code
								</h3>
								<small class="form-text text-muted mb-2 mt-2 d-block">
									Please enter the purchase code you received after payment.
								</small>
								<div class="form-group">
									<label asp-for="PurchaseCode" class="form-label visually-hidden">Purchase Code</label>
									<div class="d-flex justify-content-center">
										<input asp-for="PurchaseCode" type="text" class="form-control w-auto" style="max-width: 220px;" id="purchaseCode" />
									</div>
									<span asp-validation-for="PurchaseCode" class="text-danger"></span>
								</div>
							</div>
						</div>
						<div class="text-center mt-4">
							<button type="submit" class="btn btn-primary btn-lg" id="createTourBtn" disabled>Create My Tour</button>
						</div>
					</form>
				}
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/tour-selection.js" asp-append-version="true"></script>
}
