@model FoodTour.Models.TourCancelledVM
@{
	ViewData["Title"] = "Tour Cancelled";
}
<div class="container mt-5 text-center">
	<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="card shadow-sm mb-4 border-secondary-subtle">
				<div class="card-body p-4 p-md-5">
					<h1 class="card-title mb-4">
						<i class="bi bi-exclamation-triangle text-warning"></i> Tour Cancelled
					</h1>

					<p class="lead mb-3">This tour has been marked as cancelled.</p>
					<p class="mb-3">If you believe this is in error, please contact our support team for assistance.</p>

					@if (!string.IsNullOrWhiteSpace(Model.CustomerEmail)) {
						<div class="bg-light border-secondary text-start mb-4 p-3">
							<strong>Booking Details:</strong>
							<ul class="mb-0 mt-2">
								<li><strong>Email:</strong> @Model.CustomerEmail</li>
								@if (!string.IsNullOrWhiteSpace(Model.PurchaseCode)) {
									<li><strong>Booking reference:</strong> @Model.PurchaseCode</li>
								}
								@if (Model.TourDate != DateTime.MinValue) {
									<li><strong>Tour Date:</strong> @Model.TourDate.ToString("D")</li>
								}
							</ul>
						</div>
					}

					<a asp-controller="Home" asp-action="UserSupport" class="btn btn-outline-primary btn-lg">
						<i class="bi bi-headset"></i> Contact Support
					</a>

				</div>
			</div>
		</div>
	</div>
</div>
