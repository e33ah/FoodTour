@model FoodTour.ViewModels.VisitConfirmationVM

@{
	ViewData["Title"] = "Visit Confirmation";
}

<div class="container mt-5">
	<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="row justify-content-center">
		<div class="col-12 col-md-8 col-lg-6">
			<div class="card shadow-sm text-center">
				<div class="card-body p-4 p-md-5">
					<h1 class="card-title mb-4">
						<i class="bi bi-check-circle text-success" aria-hidden="true"></i> Success!
					</h1>

					<p>Thank you, your customer's Food Tour visit has been recorded!</p>

					<div class="alert alert-success mb-3">
						Please prepare <strong>@Model.TastingExperiencesClaimed</strong> tasting experience@(Model.TastingExperiencesClaimed != 1 ? "s" : "") for the customer
						<!--Hidden as requested by Kabincraft - may be redisplayed if business rules change-->
						<!--@if (Model.TastingExperiencesClaimed < Model.TotalGuests) {
							<br />
							<small class="text-muted">(@(Model.TotalGuests - Model.TastingExperiencesClaimed) of @Model.TotalGuests guest@(Model.TotalGuests != 1 ? "s" : "") not served)</small>
						}-->
					</div>

					<p class="text-muted small mb-0">Kabincraft Adventures will be in contact shortly, to reimburse funds.</p>
				</div>
			</div>
		</div>
		<div class="text-center mt-4">
			<p class="text-muted">
				Need help? Visit our
				<a asp-controller="Home" asp-action="UserSupport">Support</a> page.
			</p>
		</div>
	</div>
</div>
