@{
	ViewData["Title"] = "Visit Confirmation";
}
<div class="container text-center mt-5">
	<img src="~/images/logo_with_wording.jpg" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block" style="max-height: 100px;" />
	<div class="container">
		<div class="row justify-content-center text-center">
			<div class="col-md-8 col-lg-6">
				<div class="card mb-4">
					<div class="card-body">
						<h1 class="card-title mb-4">
							<i class="bi bi-check-circle text-success" aria-hidden="true"></i> Success!
						</h1>

						<p>Thank you, your customer's Food Tour visit has been recorded!</p>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>