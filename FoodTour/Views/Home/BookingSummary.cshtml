@model FoodTour.Models.BookingSummaryVM
@{
	ViewData["Title"] = "BookingSummary";
}

<div class="container mt-5">
	<img src="~/images/logo_with_wording.png" alt="Kabincraft Food Tours Logo" class="img-fluid mb-3 mx-auto d-block page-logo" />
	<div class="row justify-content-center">
		<div class="col-md-8 col-lg-6">
			<div class="card shadow-sm">
				<div class="card-body p-4 p-md-5">
					<h1 class="card-title text-center mb-4">
						<i class="bi bi-card-checklist text-primary"></i> Booking Summary
					</h1>
					@if (!ViewData.ModelState.IsValid) {
						<div class="alert alert-danger" role="alert">
							<i class="bi bi-exclamation-triangle"></i>
							<div class="text-danger">
								@foreach (var modelError in ViewData.ModelState.Where(x => x.Value != null).SelectMany(x => x.Value!.Errors)) {
									<div>@Html.Raw(modelError.ErrorMessage)</div>
								}
							</div>
						</div>
					}
					<p class="mt-3 text-center">Here are your selections for your Weymouth Self-Guided Tasting Tour:</p>
					<ul class="list-group list-group-flush">
						<li class="list-group-item">
							<strong>Tour Date:</strong> @Model.TourDate.ToString("D")
						</li>
						<li class="list-group-item">
							<strong>Email:</strong> @Model.CustomerEmail
						</li>
						<li class="list-group-item">
							<strong>Selected Tasting Experiences:</strong>
							<ul>
								@foreach (var supplier in Model.SelectedSuppliers) {
									<li>@supplier.Name - @supplier.Address</li>
								}
							</ul>
						</li>
						<li class="list-group-item mt-3 text-center">
							<strong>Does this look correct?</strong><br />
							Please confirm to save your booking.
						</li>
					</ul>
					<div class="mt-4 d-flex justify-content-between align-items-center flex-column flex-sm-row">
						<a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary mb-2 mb-sm-0">
							<i class="bi bi-arrow-left-circle"></i> Back to Home
						</a>
						<form asp-action="ConfirmBookingSummary" method="post" class="d-inline">
							@Html.AntiForgeryToken()
							<input type="hidden" name="qrToken" value="@Model.QrToken" />
							<button type="submit" class="btn btn-success ms-sm-2" id="btnConfirm">
								<i class="bi bi-check-circle"></i> Confirm Booking
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>