@model FoodTour.ViewModels.AdminBookingsVM
@{
	ViewData["Title"] = "Bookings";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mt-3">Bookings</h1>

<div class="btn-group mb-3" role="group" aria-label="Booking filter">
	<a asp-action="Bookings" class="btn btn-sm @(Model.ActiveFilter == null ? "btn-primary" : "btn-outline-primary")">All</a>
	<a asp-action="Bookings" asp-route-filter="upcoming" class="btn btn-sm @(Model.ActiveFilter == "upcoming" ? "btn-primary" : "btn-outline-primary")">Upcoming</a>
	<a asp-action="Bookings" asp-route-filter="past" class="btn btn-sm @(Model.ActiveFilter == "past" ? "btn-primary" : "btn-outline-primary")">Past</a>
	<a asp-action="Bookings" asp-route-filter="cancelled" class="btn btn-sm @(Model.ActiveFilter == "cancelled" ? "btn-secondary" : "btn-outline-secondary")">Cancelled</a>
</div>

@if (!Model.Bookings.Any()) {
	<p class="text-muted">No bookings found.</p>
} else {
	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead class="table-light">
				<tr>
					<th>Tour Date</th>
					<th>Customer</th>
					<th>Booking Ref</th>
					<th class="text-center">Guests</th>
					<th class="text-center">Tasting Experiences</th>
					<th>Status</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var booking in Model.Bookings) {
					<tr>
						<td class="text-nowrap">@booking.TourDate.ToString("ddd dd MMM yyyy")</td>
						<td>
							@if (!string.IsNullOrEmpty(booking.CustomerName)) {
								<div class="fw-semibold">@booking.CustomerName</div>
							}
							<div class="small text-muted">@booking.CustomerEmail</div>
						</td>
						<td>@booking.PurchaseCode</td>
						<td class="text-center">@booking.TotalGuests</td>
						<td class="text-center">
							@if (booking.SelectedSupplierIds.Count > 0) {
								<span class="badge text-bg-success">@booking.SelectedSupplierIds.Count selected</span>
							} else {
								<span class="badge text-bg-warning">None</span>
							}
						</td>
						<td>
							@if (booking.IsCancelled) {
								<span class="badge text-bg-danger">Cancelled</span>
							} else if (booking.TourDate.Date < DateTime.UtcNow.Date) {
								<span class="badge text-bg-secondary">Past</span>
							} else if (booking.TourDate.Date == DateTime.UtcNow.Date) {
								<span class="badge text-bg-primary">Today</span>
							} else {
								<span class="badge text-bg-success">Upcoming</span>
							}
						</td>
						<td>
							<a asp-action="BookingDetail" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-secondary">
								<i class="bi bi-eye"></i> View
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<p class="text-muted small">
		@if (Model.TotalPages > 1) {
			<text>Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@((Model.CurrentPage - 1) * Model.PageSize + Model.Bookings.Count) of @Model.TotalCount booking@(Model.TotalCount == 1 ? "" : "s")</text>
		} else {
			<text>@Model.TotalCount booking@(Model.TotalCount == 1 ? "" : "s")</text>
		}
	</p>
	@if (Model.TotalPages > 1) {
		<nav aria-label="Bookings pagination">
			<ul class="pagination pagination-sm">
				<li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
						@if (Model.HasPreviousPage) {
							<a class="page-link" asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
						} else {
							<span class="page-link">Previous</span>
						}
					</li>
				@foreach (var entry in Model.PageNumbers) {
					if (entry.IsEllipsis) {
						<li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span><span class="visually-hidden">More pages</span></li>
					} else {
						<li class="page-item @(entry.PageNumber == Model.CurrentPage ? "active" : "")">
								<a class="page-link" asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-page="@entry.PageNumber" aria-current="@(entry.PageNumber == Model.CurrentPage ? "page" : null)">@entry.PageNumber</a>
						</li>
					}
				}
				<li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
						@if (Model.HasNextPage) {
							<a class="page-link" asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
						} else {
							<span class="page-link">Next</span>
						}
					</li>
			</ul>
		</nav>
	}
}
