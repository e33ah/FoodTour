@model FoodTour.Models.AdminBookingsVM
@{
	ViewData["Title"] = "Bookings";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mt-3">Bookings</h1>

<div class="btn-group mb-3" role="group" aria-label="Booking filter">
	<a asp-action="Bookings" class="btn btn-sm @(Model.ActiveFilter == null ? "btn-primary" : "btn-outline-primary")">All</a>
	<a asp-action="Bookings" asp-route-filter="upcoming" class="btn btn-sm @(Model.ActiveFilter == "upcoming" ? "btn-primary" : "btn-outline-primary")">Upcoming</a>
	<a asp-action="Bookings" asp-route-filter="past" class="btn btn-sm @(Model.ActiveFilter == "past" ? "btn-primary" : "btn-outline-primary")">Past</a>
	<a asp-action="Bookings" asp-route-filter="cancelled" class="btn btn-sm @(Model.ActiveFilter == "cancelled" ? "btn-secondary" : "btn-outline-secondary")">Cancelled</a>
</div>

@if (!Model.Bookings.Any()) {
	<p class="text-muted">No bookings found.</p>
} else {
	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead class="table-light">
				<tr>
					<th scope="col">
						<a asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminBookingsVM.SORT_DATE" asp-route-dir="@Model.NextDirFor(AdminBookingsVM.SORT_DATE)" asp-route-page="1" class="text-decoration-none text-dark">
							Tour Date
							<i class="bi @(Model.IsSortedBy(AdminBookingsVM.SORT_DATE) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminBookingsVM.SORT_DATE) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col">
						<a asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminBookingsVM.SORT_CUSTOMER" asp-route-dir="@Model.NextDirFor(AdminBookingsVM.SORT_CUSTOMER)" asp-route-page="1" class="text-decoration-none text-dark">
							Customer
							<i class="bi @(Model.IsSortedBy(AdminBookingsVM.SORT_CUSTOMER) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminBookingsVM.SORT_CUSTOMER) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col">
						<a asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminBookingsVM.SORT_REF" asp-route-dir="@Model.NextDirFor(AdminBookingsVM.SORT_REF)" asp-route-page="1" class="text-decoration-none text-dark">
							Booking Ref
							<i class="bi @(Model.IsSortedBy(AdminBookingsVM.SORT_REF) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminBookingsVM.SORT_REF) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col" class="text-center">
						<a asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminBookingsVM.SORT_GUESTS" asp-route-dir="@Model.NextDirFor(AdminBookingsVM.SORT_GUESTS)" asp-route-page="1" class="text-decoration-none text-dark">
							Guests
							<i class="bi @(Model.IsSortedBy(AdminBookingsVM.SORT_GUESTS) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminBookingsVM.SORT_GUESTS) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col" class="text-center">Tasting Experiences</th>
					<th scope="col">Status</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var booking in Model.Bookings) {
					string? bookingDetailUrl = Url.Action("BookingDetail", "Admin", new { id = booking.Id });
					<tr onclick="window.location.href='@bookingDetailUrl'" style="cursor: pointer;">
						<td class="text-nowrap">@booking.TourDate.ToString("ddd dd MMM yyyy")</td>
						<td>
							@if (!string.IsNullOrEmpty(booking.CustomerName)) {
								<div class="fw-semibold">@booking.CustomerName</div>
							}
							<div class="small text-muted">@booking.CustomerEmail</div>
						</td>
						<td>@booking.PurchaseCode</td>
						<td class="text-center">@booking.TotalGuests</td>
						<td class="text-center">
							@if (booking.SelectedSupplierIds.Count > 0) {
									<span class="badge bg-success-subtle text-success-emphasis">@booking.SelectedSupplierIds.Count selected</span>
							} else {
									<span class="badge bg-warning-subtle text-warning-emphasis">None</span>
							}
						</td>
						<td>
							@if (booking.IsCancelled) {
									<span class="badge bg-danger-subtle text-danger-emphasis">Cancelled</span>
							} else if (booking.TourDate.Date < DateTime.UtcNow.Date) {
									<span class="badge bg-secondary-subtle text-secondary-emphasis">Past</span>
							} else if (booking.TourDate.Date == DateTime.UtcNow.Date) {
									<span class="badge bg-primary-subtle text-primary-emphasis">Today</span>
							} else {
									<span class="badge bg-success-subtle text-success-emphasis">Upcoming</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<p class="text-muted small">
		@if (Model.TotalPages > 1) {
			<text>Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@((Model.CurrentPage - 1) * Model.PageSize + Model.Bookings.Count) of @Model.TotalCount booking@(Model.TotalCount == 1 ? "" : "s")</text>
		} else {
			<text>@Model.TotalCount booking@(Model.TotalCount == 1 ? "" : "s")</text>
		}
	</p>
	@if (Model.TotalPages > 1) {
		<nav aria-label="Bookings pagination">
			<ul class="pagination pagination-sm">
				<li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
						@if (Model.HasPreviousPage) {
							<a class="page-link" asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@Model.SortColumn" asp-route-dir="@(Model.SortDescending ? "desc" : "asc")" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
						} else {
							<span class="page-link">Previous</span>
						}
					</li>
				@foreach (var entry in Model.PageNumbers) {
					if (entry.IsEllipsis) {
						<li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span><span class="visually-hidden">More pages</span></li>
					} else {
						<li class="page-item @(entry.PageNumber == Model.CurrentPage ? "active" : "")">
								<a class="page-link" asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@Model.SortColumn" asp-route-dir="@(Model.SortDescending ? "desc" : "asc")" asp-route-page="@entry.PageNumber" aria-current="@(entry.PageNumber == Model.CurrentPage ? "page" : null)">@entry.PageNumber</a>
						</li>
					}
				}
				<li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
						@if (Model.HasNextPage) {
							<a class="page-link" asp-action="Bookings" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@Model.SortColumn" asp-route-dir="@(Model.SortDescending ? "desc" : "asc")" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
						} else {
							<span class="page-link">Next</span>
						}
					</li>
			</ul>
		</nav>
	}
}
