@model FoodTour.Models.AdminSuppliersVM
@{
	ViewData["Title"] = "Suppliers";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mt-3">
	<h1 class="mb-0">Suppliers</h1>
	<a asp-action="CreateSupplier" class="btn btn-sm btn-primary">
		<i class="bi bi-plus-lg" aria-hidden="true"></i> Add Supplier
	</a>
</div>

<p class="text-muted small mt-2 mb-0">
	Click a supplier to edit it.
</p>

<div class="btn-group mt-3" role="group" aria-label="Supplier filter">
	<a asp-action="Suppliers" class="btn btn-sm @(Model.ActiveFilter == null ? "btn-primary" : "btn-outline-primary")">All</a>
	<a asp-action="Suppliers" asp-route-filter="active" class="btn btn-sm @(Model.ActiveFilter == "active" ? "btn-success" : "btn-outline-success")">Active</a>
	<a asp-action="Suppliers" asp-route-filter="inactive" class="btn btn-sm @(Model.ActiveFilter == "inactive" ? "btn-secondary" : "btn-outline-secondary")">Inactive</a>
</div>

@if (!Model.Suppliers.Any()) {
	<p class="text-muted mt-3">No suppliers found.</p>
} else {
	<div class="table-responsive mt-3">
		<table class="table table-hover align-middle">
			<thead class="table-light">
				<tr>
					<th scope="col">
						<a asp-action="Suppliers" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminSuppliersVM.SORT_NAME" asp-route-dir="@Model.NextDirFor(AdminSuppliersVM.SORT_NAME)" class="text-decoration-none text-dark">
							Name
							<i class="bi @(Model.IsSortedBy(AdminSuppliersVM.SORT_NAME) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminSuppliersVM.SORT_NAME) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col">
						<a asp-action="Suppliers" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminSuppliersVM.SORT_CONTACT" asp-route-dir="@Model.NextDirFor(AdminSuppliersVM.SORT_CONTACT)" class="text-decoration-none text-dark">
							Contact
							<i class="bi @(Model.IsSortedBy(AdminSuppliersVM.SORT_CONTACT) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminSuppliersVM.SORT_CONTACT) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col" class="text-center">
						<a asp-action="Suppliers" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminSuppliersVM.SORT_ACTIVE" asp-route-dir="@Model.NextDirFor(AdminSuppliersVM.SORT_ACTIVE)" class="text-decoration-none text-dark">
							Active
							<i class="bi @(Model.IsSortedBy(AdminSuppliersVM.SORT_ACTIVE) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminSuppliersVM.SORT_ACTIVE) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col" class="text-center">
						<a asp-action="Suppliers" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminSuppliersVM.SORT_EMAILS" asp-route-dir="@Model.NextDirFor(AdminSuppliersVM.SORT_EMAILS)" class="text-decoration-none text-dark">
							Emails
							<i class="bi @(Model.IsSortedBy(AdminSuppliersVM.SORT_EMAILS) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminSuppliersVM.SORT_EMAILS) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var supplier in Model.Suppliers) {
					string? editSupplierUrl = Url.Action("EditSupplier", "Admin", new { id = supplier.Id, filter = Model.ActiveFilter });
					<tr class="@(supplier.IsActive ? "" : "table-secondary text-body-secondary")" onclick="window.location.href='@editSupplierUrl'" style="cursor: pointer;">
						<td>
							<div class="fw-semibold">@supplier.Name</div>
							@if (!string.IsNullOrWhiteSpace(supplier.Address)) {
								<div class="small text-muted">@supplier.Address</div>
							}
						</td>
						<td>
							<div class="fw-semibold">@supplier.ContactName</div>
							<div class="small text-muted" style="white-space: pre-wrap;">@supplier.ContactEmail</div>
						</td>
						<td class="text-center">
							@if (supplier.IsActive) {
								<span class="badge bg-success-subtle text-success-emphasis">Active</span>
							} else {
								<span class="badge bg-secondary-subtle text-secondary-emphasis">Inactive</span>
							}
						</td>
						<td class="text-center">
							@if (supplier.EmailNotificationsEnabled) {
								<span class="badge bg-success-subtle text-success-emphasis">Enabled</span>
							} else {
								<span class="badge bg-secondary-subtle text-secondary-emphasis">Disabled</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
