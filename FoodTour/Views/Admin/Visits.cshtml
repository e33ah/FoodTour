@model FoodTour.Models.AdminVisitsVM
@{
	ViewData["Title"] = "Visits";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="mt-3">Visits</h1>

<div class="btn-group mb-3" role="group" aria-label="Visit filter">
	<a asp-action="Visits" class="btn btn-sm @(Model.ActiveFilter == null ? "btn-primary" : "btn-outline-primary")">All</a>
	<a asp-action="Visits" asp-route-filter="claimed" class="btn btn-sm @(Model.ActiveFilter == "claimed" ? "btn-primary" : "btn-outline-primary")">Claimed</a>
	<a asp-action="Visits" asp-route-filter="unclaimed" class="btn btn-sm @(Model.ActiveFilter == "unclaimed" ? "btn-warning" : "btn-outline-warning")">Unclaimed</a>
	<a asp-action="Visits" asp-route-filter="unreimbursed" class="btn btn-sm @(Model.ActiveFilter == "unreimbursed" ? "btn-danger" : "btn-outline-danger")">Awaiting Reimbursement</a>
	<a asp-action="Visits" asp-route-filter="reimbursed" class="btn btn-sm @(Model.ActiveFilter == "reimbursed" ? "btn-success" : "btn-outline-success")">Reimbursed</a>
</div>

@if (!Model.Visits.Any()) {
	<p class="text-muted">No visits found.</p>
} else {
	<div id="visits-alerts" aria-live="polite"></div>

	<script>
		(function(){
			function showAlert(message, isError) {
				var container = document.getElementById('visits-alerts');
				if (!container) {
					container = document.createElement('div');
					container.id = 'visits-alerts';
					container.setAttribute('aria-live', 'polite');
					document.querySelector('.table-responsive').insertAdjacentElement('beforebegin', container);
				}
				container.innerHTML = '';
				var div = document.createElement('div');
				div.setAttribute('role', 'alert');
				div.className = 'alert ' + (isError ? 'alert-danger' : 'alert-success');
				div.textContent = message;
				container.appendChild(div);
			}

			document.querySelectorAll('form.js-mark-reimbursed').forEach(function(form){
				form.addEventListener('submit', function(e){
					e.preventDefault();
					var fd = new FormData(form);
					var url = form.action;
					fetch(url, {
						method: 'POST',
						headers: {
							'X-Requested-With': 'XMLHttpRequest'
						},
						body: new URLSearchParams(fd)
					}).then(function(response){
						return response.json().then(function(json){
							if (response.ok && json.success) {
								var row = form.closest('tr');
								// If we're on the 'unreimbursed' filter, remove the row otherwise update the badge
								var filter = form.querySelector('input[name="filter"]').value;
								if (filter === 'unreimbursed' && json.isReimbursed) {
									row.parentNode.removeChild(row);
									showAlert(json.message, false);
									return;
								}
								// update reimbursed cell
								var reimbursedCell = row.querySelector('.visit-reimbursed');
								reimbursedCell.innerHTML = json.isReimbursed ? '<span class="badge bg-success-subtle text-success-emphasis">Reimbursed</span><div class="small text-muted text-nowrap">' + (json.reimbursedAt ? new Date(json.reimbursedAt).toLocaleDateString() : '') + '</div>' : (row.querySelector('.visit-reimbursed').innerHTML = '<span class="badge bg-danger-subtle text-danger-emphasis">Pending</span>');
							// update button text
							var btn = form.querySelector('button');
							btn.className = json.isReimbursed ? 'btn btn-sm btn-outline-secondary' : 'btn btn-sm btn-outline-success';
							btn.textContent = json.isReimbursed ? 'Undo' : 'Mark Reimbursed';
							showAlert(json.message, false);
						} else {
							showAlert(json.message || 'Failed to update reimbursement status. Please try again.', true);
						}
					});
					}).catch(function(){
						showAlert('Failed to update reimbursement status. Please try again.', true);
					});
				});
			});
		})();
	</script>
	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead class="table-light">
				<tr>
					<th scope="col">
						<a asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminVisitsVM.SORT_DATE" asp-route-dir="@Model.NextDirFor(AdminVisitsVM.SORT_DATE)" asp-route-page="1" class="text-decoration-none text-dark">
							Tour Date
							<i class="bi @(Model.IsSortedBy(AdminVisitsVM.SORT_DATE) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminVisitsVM.SORT_DATE) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col">
						<a asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminVisitsVM.SORT_CUSTOMER" asp-route-dir="@Model.NextDirFor(AdminVisitsVM.SORT_CUSTOMER)" asp-route-page="1" class="text-decoration-none text-dark">
							Customer
							<i class="bi @(Model.IsSortedBy(AdminVisitsVM.SORT_CUSTOMER) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminVisitsVM.SORT_CUSTOMER) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col">
						<a asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminVisitsVM.SORT_REF" asp-route-dir="@Model.NextDirFor(AdminVisitsVM.SORT_REF)" asp-route-page="1" class="text-decoration-none text-dark">
							Booking Ref
							<i class="bi @(Model.IsSortedBy(AdminVisitsVM.SORT_REF) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminVisitsVM.SORT_REF) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col">
						<a asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminVisitsVM.SORT_SUPPLIER" asp-route-dir="@Model.NextDirFor(AdminVisitsVM.SORT_SUPPLIER)" asp-route-page="1" class="text-decoration-none text-dark">
							Supplier
							<i class="bi @(Model.IsSortedBy(AdminVisitsVM.SORT_SUPPLIER) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminVisitsVM.SORT_SUPPLIER) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col" class="text-center">
						<a asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@AdminVisitsVM.SORT_GUESTS" asp-route-dir="@Model.NextDirFor(AdminVisitsVM.SORT_GUESTS)" asp-route-page="1" class="text-decoration-none text-dark">
							Guests
							<i class="bi @(Model.IsSortedBy(AdminVisitsVM.SORT_GUESTS) ? (Model.SortDescending ? "bi-sort-down" : "bi-sort-up") : "bi-arrow-down-up opacity-25") ms-1" aria-hidden="true"></i>
							<span class="visually-hidden">@(Model.IsSortedBy(AdminVisitsVM.SORT_GUESTS) ? (Model.SortDescending ? ", sorted descending" : ", sorted ascending") : ", click to sort")</span>
						</a>
					</th>
					<th scope="col" class="text-center">Claimed</th>
					<th scope="col" class="text-center">Reimbursed</th>
					<th scope="col"></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var visit in Model.Visits) {
					<tr>
						<td class="text-nowrap">@visit.Booking.TourDate.ToString("ddd dd MMM yyyy")</td>
						<td>
							@if (!string.IsNullOrEmpty(visit.Booking.CustomerName)) {
								<div class="fw-semibold">@visit.Booking.CustomerName</div>
							}
							<div class="small text-muted">@visit.Booking.CustomerEmail</div>
						</td>
						<td>@visit.Booking.PurchaseCode</td>
						<td>@visit.Supplier.Name</td>
						<td class="text-center">@visit.Booking.TotalGuests</td>
						<td class="text-center">
							@if (visit.IsClaimed) {
								<span class="badge bg-success-subtle text-success-emphasis">Claimed</span>
								@if (visit.ClaimedAt != null) {
									<div class="small text-muted text-nowrap">@visit.ClaimedAt.Value.ToString("dd MMM yyyy")</div>
								}
							} else {
								<span class="badge bg-warning-subtle text-warning-emphasis">Unclaimed</span>
							}
						</td>
						<td class="text-center visit-reimbursed">
							@if (visit.IsSupplierReimbursed) {
								<span class="badge bg-success-subtle text-success-emphasis">Reimbursed</span>
								@if (visit.ReimbursedAt != null) {
									<div class="small text-muted text-nowrap">@visit.ReimbursedAt.Value.ToString("dd MMM yyyy")</div>
								}
							} else if (visit.IsClaimed) {
								<span class="badge bg-danger-subtle text-danger-emphasis">Pending</span>
							} else {
								<span class="badge bg-secondary-subtle text-secondary-emphasis">N/A</span>
							}
						</td>
						<td class="visit-action">
							@if (visit.IsClaimed) {
								<form asp-action="MarkReimbursed" method="post" class="js-mark-reimbursed">
									@Html.AntiForgeryToken()
									<input type="hidden" name="id" value="@visit.Id" />
									<input type="hidden" name="filter" value="@Model.ActiveFilter" />
									<input type="hidden" name="page" value="@Model.CurrentPage" />
									<input type="hidden" name="sort" value="@Model.SortColumn" />
									<input type="hidden" name="dir" value="@(Model.SortDescending ? "desc" : "asc")" />
									<button type="submit" class="btn btn-sm @(visit.IsSupplierReimbursed ? "btn-outline-secondary" : "btn-outline-success")">
										@(visit.IsSupplierReimbursed ? "Undo" : "Mark Reimbursed")
									</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<p class="text-muted small">
		@if (Model.TotalPages > 1) {
			<text>Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)–@((Model.CurrentPage - 1) * Model.PageSize + Model.Visits.Count) of @Model.TotalCount visit@(Model.TotalCount == 1 ? "" : "s")</text>
		} else {
			<text>@Model.TotalCount visit@(Model.TotalCount == 1 ? "" : "s")</text>
		}
	</p>
	@if (Model.TotalPages > 1) {
		<nav aria-label="Visits pagination">
			<ul class="pagination pagination-sm">
				<li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
						@if (Model.HasPreviousPage) {
							<a class="page-link" asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@Model.SortColumn" asp-route-dir="@(Model.SortDescending ? "desc" : "asc")" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
						} else {
							<span class="page-link">Previous</span>
						}
					</li>
				@foreach (var entry in Model.PageNumbers) {
					if (entry.IsEllipsis) {
						<li class="page-item disabled"><span class="page-link" aria-hidden="true">…</span><span class="visually-hidden">More pages</span></li>
					} else {
						<li class="page-item @(entry.PageNumber == Model.CurrentPage ? "active" : "")">
								<a class="page-link" asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@Model.SortColumn" asp-route-dir="@(Model.SortDescending ? "desc" : "asc")" asp-route-page="@entry.PageNumber" aria-current="@(entry.PageNumber == Model.CurrentPage ? "page" : null)">@entry.PageNumber</a>
						</li>
					}
				}
				<li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
						@if (Model.HasNextPage) {
							<a class="page-link" asp-action="Visits" asp-route-filter="@Model.ActiveFilter" asp-route-sort="@Model.SortColumn" asp-route-dir="@(Model.SortDescending ? "desc" : "asc")" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
						} else {
							<span class="page-link">Next</span>
						}
					</li>
			</ul>
		</nav>
	}
}
