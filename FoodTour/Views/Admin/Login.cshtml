@{
	ViewData["Title"] = "Admin Login";
}

<div class="row justify-content-center mt-5">
	<div class="col-md-4">
		@if (!(bool)(ViewData["GoogleConfigured"] ?? false)) {
			<div class="alert alert-warning mb-3" role="alert">
				<i class="bi bi-exclamation-triangle"></i>
				<strong>Google sign-in is not configured.</strong>
				Set <code>Authentication:Google:ClientId</code> and <code>Authentication:Google:ClientSecret</code> via user secrets to enable login.
			</div>
		}
		<div class="card shadow-sm">
			<div class="card-body text-center p-4">
				<i class="bi bi-shield-lock display-4 text-primary mb-3"></i>
				<h1 class="h4 mb-3">Admin Sign In</h1>
				<p class="text-muted mb-4">Sign in with your Google account to access the admin area.</p>
				<a asp-controller="Admin" asp-action="LoginWithGoogle" asp-route-returnUrl="@ViewData["ReturnUrl"]"
				   class="btn btn-outline-dark w-100 @(!(bool)(ViewData["GoogleConfigured"] ?? false) ? "disabled" : "")"
				   aria-disabled="@(!(bool)(ViewData["GoogleConfigured"] ?? false))">
					<img src="~/images/google-logo.svg" width="18" height="18" alt="Google" class="me-2" style="vertical-align:text-bottom" />
					Sign in with Google
				</a>
			</div>
		</div>
	</div>
</div>
