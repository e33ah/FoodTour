@model FoodTour.Models.AdminSupplierFormVM
@{
    ViewData["Title"] = "Edit Supplier";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string? suppliersFilter = ViewData["SuppliersFilter"] as string;
}

<div class="d-flex justify-content-between align-items-center mt-3">
    <div>
        <h1 class="mb-0">Edit Supplier</h1>
        <p class="text-muted mb-0">@Model.Name</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Suppliers" asp-route-filter="@suppliersFilter" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </a>
        <button type="submit" form="edit-supplier-form" class="btn btn-sm btn-primary">
            <i class="bi bi-check2" aria-hidden="true"></i> Save
        </button>
    </div>
</div>

@if (!Model.IsActive) {
    <div class="alert alert-warning mt-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        This supplier is <strong>inactive</strong> and will not appear in the tour selection.
    </div>
}

<form asp-action="EditSupplier" asp-route-id="@Model.Id" asp-route-filter="@suppliersFilter" method="post" class="mt-3" id="edit-supplier-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="OriginalIsActive" type="hidden" />

    <div class="row">
        <div class="col-12">
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Details</h2>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FoodTourOfferDescription" class="form-label"></label>
                        <input asp-for="FoodTourOfferDescription" class="form-control" placeholder="e.g. 1 small tasting plate per person." aria-describedby="food-tour-offer-description-help">
                        <span asp-validation-for="FoodTourOfferDescription" class="text-danger"></span>
                        <div id="food-tour-offer-description-help" class="form-text">Brief description of what is included in the food tour offer.</div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-xl-6">
                            <div class="mb-3">
                                <label asp-for="ContactName" class="form-label"></label>
                                <input asp-for="ContactName" class="form-control" autocomplete="name" />
                                <span asp-validation-for="ContactName" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ContactEmail" class="form-label"></label>
                                <input asp-for="ContactEmail" class="form-control" autocomplete="email" placeholder="name@example.com; another@example.com" />
                                <span asp-validation-for="ContactEmail" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ConfirmationCode" class="form-label"></label>
                                <input asp-for="ConfirmationCode" class="form-control" aria-describedby="confirmation-code-help" />
                                <span asp-validation-for="ConfirmationCode" class="text-danger"></span>
                                <div id="confirmation-code-help" class="form-text">This is the code businesses enter to record a visit.</div>
                            </div>
                        </div>
                        <div class="col-12 col-xl-6 mb-3">
                            <fieldset class="border rounded p-3">
                                <legend class="h6 mb-2">Status</legend>
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" aria-describedby="is-active-help" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                    <div id="is-active-help" class="form-text">Inactive suppliers do not appear in tour selection.</div>
                                </div>
                                <div class="form-check mt-2">
                                    <input asp-for="EmailNotificationsEnabled" class="form-check-input" aria-describedby="email-notifications-help" />
                                    <label asp-for="EmailNotificationsEnabled" class="form-check-label"></label>
                                    <div id="email-notifications-help" class="form-text">Sends visit-recorded emails to the supplier contact.</div>
                                </div>
                                <div class="form-check mt-2">
                                    <input asp-for="RequiresConfirmationCode" class="form-check-input" aria-describedby="requires-confirmation-code-help" />
                                    <label asp-for="RequiresConfirmationCode" class="form-check-label"></label>
                                    <div id="requires-confirmation-code-help" class="form-text">When enabled, businesses must enter their confirmation code to record a visit.</div>
                                </div>
                            </fieldset>
                        </div>
                    </div>

                    <h2 class="h5 mt-4">Tags</h2>
                    <p class="text-muted small mb-3">Tags display as little badges on the main screen. They are optional.</p>

                    <div class="row">
                        <div class="col-12 col-md-3 mb-3">
                            <label asp-for="Tag1" class="form-label"></label>
                            <input asp-for="Tag1" class="form-control" />
                            <span asp-validation-for="Tag1" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3 mb-3">
                            <label asp-for="Tag2" class="form-label"></label>
                            <input asp-for="Tag2" class="form-control" />
                            <span asp-validation-for="Tag2" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3 mb-3">
                            <label asp-for="Tag3" class="form-label"></label>
                            <input asp-for="Tag3" class="form-control" />
                            <span asp-validation-for="Tag3" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-3 mb-3">
                            <label asp-for="Tag4" class="form-label"></label>
                            <input asp-for="Tag4" class="form-control" />
                            <span asp-validation-for="Tag4" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h5">Opening times</h2>
                    <p class="text-muted small mb-3">Day-specific values will override the default opening times.</p>

                    <div class="mb-3">
                        <label asp-for="OpeningTimes" class="form-label"></label>
                        <textarea asp-for="OpeningTimes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="OpeningTimes" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesMonday" class="form-label"></label>
                            <input asp-for="OpeningTimesMonday" class="form-control" />
                            <span asp-validation-for="OpeningTimesMonday" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesTuesday" class="form-label"></label>
                            <input asp-for="OpeningTimesTuesday" class="form-control" />
                            <span asp-validation-for="OpeningTimesTuesday" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesWednesday" class="form-label"></label>
                            <input asp-for="OpeningTimesWednesday" class="form-control" />
                            <span asp-validation-for="OpeningTimesWednesday" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesThursday" class="form-label"></label>
                            <input asp-for="OpeningTimesThursday" class="form-control" />
                            <span asp-validation-for="OpeningTimesThursday" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesFriday" class="form-label"></label>
                            <input asp-for="OpeningTimesFriday" class="form-control" />
                            <span asp-validation-for="OpeningTimesFriday" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesSaturday" class="form-label"></label>
                            <input asp-for="OpeningTimesSaturday" class="form-control" />
                            <span asp-validation-for="OpeningTimesSaturday" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6 mb-3">
                            <label asp-for="OpeningTimesSunday" class="form-label"></label>
                            <input asp-for="OpeningTimesSunday" class="form-control" />
                            <span asp-validation-for="OpeningTimesSunday" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check2" aria-hidden="true"></i> Save
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.getElementById('edit-supplier-form');
            if (!form) {
                return;
            }

            var originalIsActive = form.querySelector('input[type="hidden"][name="OriginalIsActive"]');
            var isActive = form.querySelector('input[type="checkbox"][name="IsActive"]');
            var requiresConfirmationCode = form.querySelector('input[type="checkbox"][name="RequiresConfirmationCode"]');
            var confirmationCodeInput = form.querySelector('input[name="ConfirmationCode"]');
            var emailNotificationsEnabled = form.querySelector('input[type="checkbox"][name="EmailNotificationsEnabled"]');
            var contactEmailInput = form.querySelector('input[name="ContactEmail"]');

            function toggleConfirmationCodeInput() {
                if (!requiresConfirmationCode || !confirmationCodeInput) {
                    return;
                }

                var isRequired = requiresConfirmationCode.checked;
                confirmationCodeInput.disabled = !isRequired;
                confirmationCodeInput.classList.toggle('bg-light', !isRequired);
                confirmationCodeInput.classList.toggle('text-muted', !isRequired);
                confirmationCodeInput.setAttribute('aria-disabled', (!isRequired).toString());
            }

            function toggleContactEmailInput() {
                if (!emailNotificationsEnabled || !contactEmailInput) {
                    return;
                }

                var notificationsEnabled = emailNotificationsEnabled.checked;
                contactEmailInput.disabled = !notificationsEnabled;
                contactEmailInput.classList.toggle('bg-light', !notificationsEnabled);
                contactEmailInput.classList.toggle('text-muted', !notificationsEnabled);
                contactEmailInput.setAttribute('aria-disabled', (!notificationsEnabled).toString());
            }

            function shouldConfirmInactivation() {
                if (!originalIsActive || !isActive) {
                    return false;
                }

                var wasActive = (originalIsActive.value || '').toLowerCase() === 'true';
                var willBeActive = isActive.checked;
                return wasActive && !willBeActive;
            }

            var hasConfirmedInactivation = false;

            function confirmInactivationOnce() {
                if (!shouldConfirmInactivation()) {
                    return true;
                }

                if (hasConfirmedInactivation) {
                    return true;
                }

                var confirmed = window.confirm('Are you sure? Marking this supplier as inactive will stop any future bookings being made to this business.');
                if (confirmed) {
                    hasConfirmedInactivation = true;
                }

                return confirmed;
            }

            form.addEventListener('submit', function (e) {
                if (confirmationCodeInput) {
                    confirmationCodeInput.disabled = false;
                }
                if (contactEmailInput) {
                    contactEmailInput.disabled = false;
                }

                if (!confirmInactivationOnce()) {
                    e.preventDefault();
                    toggleConfirmationCodeInput();
                    toggleContactEmailInput();
                }
            });

            var nativeSubmit = form.submit;
            form.submit = function () {
                if (confirmInactivationOnce()) {
                    if (confirmationCodeInput) {
                        confirmationCodeInput.disabled = false;
                    }
                    if (contactEmailInput) {
                        contactEmailInput.disabled = false;
                    }
                    nativeSubmit.call(form);
                }
            };

            if (requiresConfirmationCode) {
                requiresConfirmationCode.addEventListener('change', toggleConfirmationCodeInput);
            }
            if (emailNotificationsEnabled) {
                emailNotificationsEnabled.addEventListener('change', toggleContactEmailInput);
            }

            toggleConfirmationCodeInput();
            toggleContactEmailInput();
        })();
    </script>
}
