@{
	ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
	<div class="col-md-5">
		<div class="card shadow-sm border-danger">
			<div class="card-body text-center p-4">
				<i class="bi bi-shield-x display-4 text-danger mb-3"></i>
				<h1 class="h4 mb-3">Access Denied</h1>
				<p class="text-muted mb-4">
					Your Google account is not authorised to access the admin area.
					Please contact the site administrator if you believe this is an error.
				</p>
				<form asp-controller="Admin" asp-action="Logout" method="post">
						<button type="submit" class="btn btn-outline-secondary">
							<i class="bi bi-arrow-left"></i> Back to Login
						</button>
					</form>
			</div>
		</div>
	</div>
</div>
